rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.superAdmin == true;
    }
    
    function isOwner(resourceData) {
      return isAuthenticated() && request.auth.uid == resourceData.ownerUid;
    }

    function isBoolean(value) {
      return value == true || value == false;
    }

    function getActiveLocationMode() {
      return exists(/databases/$(database)/documents/settings/queue)
        && get(/databases/$(database)/documents/settings/queue).data.locationMode == 'test'
          ? 'test'
          : 'production';
    }

    function isKnownLocationMode(mode) {
      return mode == 'production' || mode == 'test';
    }

    function getTestLocationName() {
      return exists(/databases/$(database)/documents/settings/queue)
        && get(/databases/$(database)/documents/settings/queue).data.testLocationName is string
        && get(/databases/$(database)/documents/settings/queue).data.testLocationName.size() > 0
          ? get(/databases/$(database)/documents/settings/queue).data.testLocationName
          : '394F+278, Madeena Rd, Kuttiyeri, Kerala 670141';
    }

    function isKnownStoreName(storeName, mode) {
      return (mode == 'production' && storeName == 'Nahdi Mandi Kannur')
        || (mode == 'test' && storeName == getTestLocationName());
    }

    function getTestLocationLatitude() {
      return exists(/databases/$(database)/documents/settings/queue)
        && get(/databases/$(database)/documents/settings/queue).data.testLocationLatitude is number
          ? get(/databases/$(database)/documents/settings/queue).data.testLocationLatitude
          : 12.0551063;
    }

    function getTestLocationLongitude() {
      return exists(/databases/$(database)/documents/settings/queue)
        && get(/databases/$(database)/documents/settings/queue).data.testLocationLongitude is number
          ? get(/databases/$(database)/documents/settings/queue).data.testLocationLongitude
          : 75.3731213;
    }

    function getTestLocationRadiusMeters() {
      return exists(/databases/$(database)/documents/settings/queue)
        && get(/databases/$(database)/documents/settings/queue).data.testLocationRadiusMeters is number
        && get(/databases/$(database)/documents/settings/queue).data.testLocationRadiusMeters > 0
          ? get(/databases/$(database)/documents/settings/queue).data.testLocationRadiusMeters
          : 2500;
    }

    function getLocationRadiusMeters(mode) {
      return mode == 'test' ? getTestLocationRadiusMeters() : 2500;
    }

    function getStoreLatitudeForMode(mode) {
      return mode == 'test' ? getTestLocationLatitude() : 11.8598637;
    }

    function getStoreLongitudeForMode(mode) {
      return mode == 'test' ? getTestLocationLongitude() : 75.4147016;
    }

    function isMatchingLocationSnapshot(location, mode, requireWithinRadius) {
      return location is map
        && location.lat is number
        && location.lng is number
        && location.accuracyMeters is number
        && location.distanceMeters is number
        && isBoolean(location.withinRadius)
        && location.storeMode == mode
        && isKnownStoreName(location.storeName, mode)
        && location.accuracyMeters >= 0
        && location.accuracyMeters <= 10000
        && location.distanceMeters >= 0
        && (!requireWithinRadius || (location.withinRadius == true && location.distanceMeters <= getLocationRadiusMeters(mode)));
    }

    // Coarse bounding box around the store center sized to the active radius.
    // Longitude uses /100000 to overestimate the box at Kerala latitudes
    // (cos(12 deg) ~ 0.978 => 1 deg lng ~ 108577 m) so legitimate points on
    // the east/west edge of the circle are never rejected. The precise
    // circle check lives in isMatchingLocationSnapshot via distanceMeters.
    function isJoinLocationInsideMode(location, mode) {
      return isMatchingLocationSnapshot(location, mode, true)
        && location.lat >= getStoreLatitudeForMode(mode) - (getLocationRadiusMeters(mode) / 111000.0)
        && location.lat <= getStoreLatitudeForMode(mode) + (getLocationRadiusMeters(mode) / 111000.0)
        && location.lng >= getStoreLongitudeForMode(mode) - (getLocationRadiusMeters(mode) / 100000.0)
        && location.lng <= getStoreLongitudeForMode(mode) + (getLocationRadiusMeters(mode) / 100000.0);
    }

    function isCounterLinkedToEntry(dateKey, entryId, ownerUid, queueNumber) {
      return getAfter(/databases/$(database)/documents/queue_counters/$(dateKey)).data.lastEntryId == entryId
        && getAfter(/databases/$(database)/documents/queue_counters/$(dateKey)).data.lastOwnerUid == ownerUid
        && getAfter(/databases/$(database)/documents/queue_counters/$(dateKey)).data.lastQueueNumber == queueNumber;
    }

    function isValidCustomerQueueCreate(dateKey, entryId) {
      return request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.queueDate == dateKey
        && request.resource.data.joinSource == 'public'
        && request.resource.data.locationMode == getActiveLocationMode()
        && isKnownStoreName(request.resource.data.storeName, request.resource.data.locationMode)
        && isJoinLocationInsideMode(request.resource.data.location, request.resource.data.locationMode)
        && request.resource.data.tableReadyLocation == null
        && request.resource.data.tableReadyCheckedAt == null
        && request.resource.data.respondedAt == null
        && isCounterLinkedToEntry(
          dateKey,
          entryId,
          request.resource.data.ownerUid,
          request.resource.data.queueNumber
        );
    }

    function isValidAdminQueueCreate(dateKey, entryId) {
      return request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.queueDate == dateKey
        && request.resource.data.joinSource == 'admin'
        && isKnownLocationMode(request.resource.data.locationMode)
        && isKnownStoreName(request.resource.data.storeName, request.resource.data.locationMode)
        && request.resource.data.location == null
        && request.resource.data.tableReadyLocation == null
        && request.resource.data.tableReadyCheckedAt == null
        && request.resource.data.respondedAt == null
        && isCounterLinkedToEntry(
          dateKey,
          entryId,
          request.resource.data.ownerUid,
          request.resource.data.queueNumber
        );
    }

    function isValidOwnerQueueUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fcmToken',
        'fcmTokenUpdatedAt',
        'tableReadyLocation',
        'tableReadyCheckedAt',
        'respondedAt'
      ])
        && (
          request.resource.data.tableReadyLocation == resource.data.tableReadyLocation
          || isMatchingLocationSnapshot(
            request.resource.data.tableReadyLocation,
            resource.data.locationMode,
            false
          )
        )
        && (
          request.resource.data.respondedAt == null
          || request.resource.data.tableReadyLocation.withinRadius == true
        );
    }

    match /customers_per_day/{dateKey}/entries/{entryId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && (
          (isAdmin() && isValidAdminQueueCreate(dateKey, entryId))
          || (!isAdmin() && isValidCustomerQueueCreate(dateKey, entryId))
        );
      allow update: if isAdmin() || (isOwner(resource.data) && isValidOwnerQueueUpdate());
      allow delete: if isAdmin();
    }

    match /{path=**}/entries/{entryId} {
      allow get, list: if isAdmin();
    }

    match /queue_public/{entryId} {
      // Anyone can read the public queue (for dashboard/status position)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.queueDate is string
        && existsAfter(/databases/$(database)/documents/customers_per_day/$(request.resource.data.queueDate)/entries/$(entryId))
        && getAfter(/databases/$(database)/documents/customers_per_day/$(request.resource.data.queueDate)/entries/$(entryId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/customers_per_day/$(request.resource.data.queueDate)/entries/$(entryId)).data.queueNumber == request.resource.data.queueNumber
        && getAfter(/databases/$(database)/documents/customers_per_day/$(request.resource.data.queueDate)/entries/$(entryId)).data.partySize == request.resource.data.partySize
        && getAfter(/databases/$(database)/documents/customers_per_day/$(request.resource.data.queueDate)/entries/$(entryId)).data.status == request.resource.data.status;
      // Only admins update or delete the public queue status
      allow update, delete: if isAdmin();
    }

    match /queue_counters/{dateKey} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.lastQueueNumber == 1
        && request.resource.data.lastEntryId is string
        && request.resource.data.lastOwnerUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId))
        && getAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId)).data.queueNumber == 1;
      allow update: if isAuthenticated()
        && request.resource.data.lastQueueNumber == resource.data.lastQueueNumber + 1
        && request.resource.data.lastEntryId is string
        && request.resource.data.lastOwnerUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId))
        && getAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/customers_per_day/$(dateKey)/entries/$(request.resource.data.lastEntryId)).data.queueNumber == request.resource.data.lastQueueNumber;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isAdmin()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.ticketToEmail == 'musthafaak56@gmail.com'
        && request.resource.data.status == 'open';
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
